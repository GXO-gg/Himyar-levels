# /etc/systemd/system/himyar-levels.service
[Unit]
Description=Himyar Levels Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=himyar
Group=himyar
WorkingDirectory=/home/himyar/bots/himyar-levels
ExecStart=/home/himyar/bots/himyar-levels/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=himyar-levels

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/himyar/bots/himyar-levels

[Install]
WantedBy=multi-user.target
